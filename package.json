{
  "name": "roarlist",
  "productName": "RoarList",
  "version": "0.2.0",
  "description": "RoarList: shot lists and storyboards for shoots, for Mac and Windows. TheMadlions Lab, Experiment 04.",
  "author": "THEMADLIONS",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=dist/main.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist/preload.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource/jost": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.themadlions.roarlist",
    "productName": "RoarList",
    "directories": { "output": "out", "buildResources": "build" },
    "files": ["dist/**/*", "package.json"],
    "afterPack": "./build/adhoc-sign.js",
    "fileAssociations": [{ "ext": "roarlist", "name": "RoarList Shot List", "role": "Editor" }],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "RoarList-${version}-beta-Mac-${arch}.${ext}"
    },
    "dmg": { "artifactName": "RoarList-${version}-beta-Mac-${arch}.${ext}", "title": "RoarList" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "RoarList-${version}-beta-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RoarList"
    }
  }
}
